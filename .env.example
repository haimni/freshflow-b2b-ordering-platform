# =============================================================================
# FreshFlow B2B Ordering Platform - Development Environment
# =============================================================================
# Copy this file to .env. Never commit the real .env file.

# Application
APP_NAME=FreshFlow B2B API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# MySQL
MYSQL_DATABASE=freshflow_b2b
MYSQL_USER=freshflow_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_HOST=localhost
MYSQL_PORT=3307

# SQLAlchemy connection string used by FastAPI
DATABASE_URL=mysql+pymysql://freshflow_app:change_me@localhost:3307/freshflow_b2b

# Authentication values will be activated in the authentication stage.
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
